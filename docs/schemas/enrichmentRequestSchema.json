{
  "$defs": {
    "GBVRequestData": {
      "properties": {
        "iName": {
          "const": "gbv",
          "default": "gbv",
          "title": "Iname",
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The primary search term (PPN / Bib-ID or ISBN)",
          "examples": [
            "123456789X",
            "9783161484100"
          ],
          "title": "Identifier"
        },
        "identifierType": {
          "anyOf": [
            {
              "enum": [
                "bibId",
                "isbn"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicitly state what type the identifier is (bibId maps to PPN for K10plus)",
          "examples": [
            "bibId",
            "isbn"
          ],
          "title": "Identifiertype"
        },
        "gndId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct GND ID bypass if known",
          "title": "Gndid"
        },
        "wikidataId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct Wikidata ID bypass if known",
          "title": "Wikidataid"
        },
        "isbn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct ISBN ID bypass if known",
          "title": "Isbn"
        },
        "fetchMarc21MD": {
          "default": true,
          "description": "Fetch core MARC21 record via SRU",
          "title": "Fetchmarc21Md",
          "type": "boolean"
        },
        "fetchLobidGND": {
          "default": true,
          "description": "Enrich via Lobid GND API",
          "title": "Fetchlobidgnd",
          "type": "boolean"
        },
        "fetchWikidata": {
          "default": true,
          "description": "Enrich via Wikidata SPARQL",
          "title": "Fetchwikidata",
          "type": "boolean"
        },
        "fetchCover": {
          "default": false,
          "description": "Fetch Book Cover via multi-tier waterfall",
          "title": "Fetchcover",
          "type": "boolean"
        },
        "fetchDescription": {
          "default": false,
          "description": "Fetch Book Description / Abstract",
          "title": "Fetchdescription",
          "type": "boolean"
        },
        "fetchSimilarByPerson": {
          "default": false,
          "description": "Fetch subsidiary records by the author's name",
          "title": "Fetchsimilarbyperson",
          "type": "boolean"
        },
        "fetchSimilarBySubject": {
          "default": false,
          "description": "Fetch subsidiary records by subject headings",
          "title": "Fetchsimilarbysubject",
          "type": "boolean"
        },
        "fetchSimilarByClassification": {
          "default": false,
          "description": "Fetch subsidiary records by classification numbers",
          "title": "Fetchsimilarbyclassification",
          "type": "boolean"
        },
        "maxRecs": {
          "default": 5,
          "description": "Maximum number of additional records to return per strategy",
          "maximum": 50,
          "minimum": 1,
          "title": "Maxrecs",
          "type": "integer"
        }
      },
      "title": "GBVRequestData",
      "type": "object"
    },
    "LibraryCategory": {
      "properties": {
        "iType": {
          "const": "bib",
          "default": "bib",
          "title": "Itype",
          "type": "string"
        },
        "institution": {
          "discriminator": {
            "mapping": {
              "gbv": "#/$defs/GBVRequestData",
              "oenb": "#/$defs/OeNBRequestData"
            },
            "propertyName": "iName"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OeNBRequestData"
            },
            {
              "$ref": "#/$defs/GBVRequestData"
            }
          ],
          "title": "Institution"
        }
      },
      "required": [
        "institution"
      ],
      "title": "LibraryCategory",
      "type": "object"
    },
    "OeNBRequestData": {
      "properties": {
        "iName": {
          "const": "oenb",
          "default": "oenb",
          "title": "Iname",
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The primary search term (Barcode or Bib-ID/AC-Number)",
          "examples": [
            "AC14474940",
            "+Z168276302"
          ],
          "title": "Identifier"
        },
        "identifierType": {
          "anyOf": [
            {
              "enum": [
                "barcode",
                "bibId",
                "ac",
                "isbn"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicitly state what type the identifier is",
          "examples": [
            "bibId",
            "barcode",
            "isbn"
          ],
          "title": "Identifiertype"
        },
        "gndId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct GND ID bypass if known",
          "examples": [
            null,
            "2024703-5"
          ],
          "title": "Gndid"
        },
        "wikidataId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct Wikidata ID bypass if known",
          "examples": [
            null,
            "Q76518"
          ],
          "title": "Wikidataid"
        },
        "isbn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct ISBN ID bypass if known",
          "examples": [
            null,
            "9781473224469"
          ],
          "title": "Isbn"
        },
        "fetchMarc21MD": {
          "default": true,
          "description": "Fetch core MARC21 record via SRU",
          "title": "Fetchmarc21Md",
          "type": "boolean"
        },
        "fetchLobidGND": {
          "default": true,
          "description": "Enrich via Lobid GND API",
          "title": "Fetchlobidgnd",
          "type": "boolean"
        },
        "fetchWikidata": {
          "default": true,
          "description": "Enrich via Wikidata SPARQL",
          "title": "Fetchwikidata",
          "type": "boolean"
        },
        "fetchCover": {
          "default": false,
          "description": "Fetch Book Cover via multi-tier waterfall",
          "title": "Fetchcover",
          "type": "boolean"
        },
        "fetchDescription": {
          "default": false,
          "description": "Fetch Book Description / Abstract",
          "title": "Fetchdescription",
          "type": "boolean"
        },
        "fetchSimilarByPerson": {
          "default": false,
          "description": "Fetch subsidiary records by person's name",
          "title": "Fetchsimilarbyperson",
          "type": "boolean"
        },
        "fetchSimilarBySubject": {
          "default": false,
          "description": "Fetch subsidiary records by subject headings",
          "title": "Fetchsimilarbysubject",
          "type": "boolean"
        },
        "fetchSimilarByClassification": {
          "default": false,
          "description": "Fetch subsidiary records by classification numbers",
          "title": "Fetchsimilarbyclassification",
          "type": "boolean"
        },
        "maxRecs": {
          "default": 5,
          "description": "Maximum number of additional records to return per strategy",
          "maximum": 50,
          "minimum": 1,
          "title": "Maxrecs",
          "type": "integer"
        }
      },
      "title": "OeNBRequestData",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "bib": "#/$defs/LibraryCategory"
    },
    "propertyName": "iType"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/LibraryCategory"
    }
  ]
}